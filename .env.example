# Video Agent Context Graph — configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit real credentials to git.

# --- Neo4j (self-hosted / Aura, bolt protocol) -----------------------------
# Aura: neo4j+s://<dbid>.databases.neo4j.io    Local docker: neo4j://localhost:7687
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# --- OpenAI (agent reasoning + structured video extraction) ----------------
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-5.6
OPENAI_EXTRACTION_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low

# --- TwelveLabs (video understanding: Marengo + Pegasus) -------------------
# The SDK reads TWELVE_LABS_API_KEY directly from the environment.
TWELVE_LABS_API_KEY=your-twelvelabs-key-here
# Reuse an existing index (skip creation) by id, or leave blank to create/find by name:
TL_INDEX_ID=
TL_INDEX_NAME=video-context-graph
# Model versions (bump as TwelveLabs ships new ones):
MARENGO_MODEL=marengo3.0
PEGASUS_MODEL=pegasus1.2
MARENGO_EMBED_MODEL=marengo3.0

# Sample clip(s) to ingest with `make seed` (comma-separated direct MP4 URLs).
# Big Buck Bunny 720p is the license-clean fallback that passes TwelveLabs
# validation: https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4
SAMPLE_VIDEO_URLS=https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/720/Big_Buck_Bunny_720_10s_5MB.mp4

# --- App -------------------------------------------------------------------
DOMAIN_ID=video-context-graph
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS — comma-separated origins allowed for the frontend
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
